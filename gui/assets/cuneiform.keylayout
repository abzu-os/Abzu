			<when state="circumflexbelow" output="ḓ" /> <!-- added -->
			<when state="macronbelow" output="ḏ" /> <!-- added -->
		</action>
		<action id="E">
			<when state="tlit" output="Ē"/>
			<when state="tlit_s" output="É"/>
			<when state="tlit_c" output="Ê"/>
			<when state="tlit_cs" output="È"/>
			<when state="tlit_det" output=""/>
			<when state="tlit_det_s" output=""/>
